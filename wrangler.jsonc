{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "signal-room-grafana-lab",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-19",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"],
  },
}
